# Local setup works without environment variables after npm run tracker:db:local.
# Hosted first-account setup is shown only to this verified Sites account email.
# Configure this as a server-side Sites environment variable (never NEXT_PUBLIC_).
# TRACKER_SETUP_EMAIL=owner@example.com

# Netlify first-account setup uses a private server-side key of at least 32
# characters. Set it in Netlify environment variables before deploying.
# Never prefix it with NEXT_PUBLIC_ or commit a real value.
# TRACKER_SETUP_KEY=<generate-a-long-random-secret>

# Netlify tracker storage: Firebase project ID and the entire service-account
# JSON as a single secret environment variable. Never prefix with NEXT_PUBLIC_.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Local Firestore emulator only. Omit on Netlify.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
